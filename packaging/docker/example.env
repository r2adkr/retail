# Optional: a host name pointing at this server, used in invite codes instead
# of its IP address. No certificate is needed: devices trust the server
# through the key fingerprint in their invites.
#RETAIL_SERVE_DOMAIN=vpn.example.com

# Optional: HTTPS address of a CDN that forwards to this server, for devices
# on networks that block its address (comma-separated for several)
#RETAIL_SERVE_FRONT=https://cdn.example.com

# Optional: helper node code, for a server that other networks cannot reach
#RETAIL_SERVE_HELPER=retailh1....

# Be a helper node instead of a server
#RETAIL_SERVE=0
#RETAIL_HELPER=1
#RETAIL_HELPER_PUBLIC=vps.example.com
