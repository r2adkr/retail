# retail node daemon (Linux).
#
#   install -m 0755 retaild retail /usr/local/bin/
#   install -m 0644 retaild.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now retaild
#   retail up --invite retail1....           # join a network, or
#   retail server start [--no-join]           # host one here (resumes at boot)

[Unit]
Description=retail node daemon
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/retaild --state-dir /var/lib/retail
Restart=on-failure
RestartSec=2
StateDirectory=retail
StateDirectoryMode=0700

# CAP_NET_ADMIN covers the TUN device, exit-node routes and firewall rules,
# socket marks and forced socket buffer sizes. CAP_NET_BIND_SERVICE lets a
# hosted network listen on port 443
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=yes
ProtectSystem=strict
# Updates replace the programs in their folder (retail set --auto-update)
ReadWritePaths=/usr/local/bin
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
